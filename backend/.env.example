# SQLAlchemy connection string. SQLite for development; swap for a
# postgresql+psycopg://... URL later without any code changes.
DATABASE_URL=sqlite:///./adriva.db

# Shared secret that gates every private management endpoint (companies,
# employees, products, themes, uploads) — checked as `Authorization: Bearer
# <ADMIN_API_KEY>`. Required: leaving this blank locks those routes out
# entirely rather than leaving them open. Generate one with, e.g.:
#   openssl rand -hex 32
# The dashboard prompts for this once and remembers it in the browser's
# localStorage — there's no separate login form.
ADMIN_API_KEY=

# The Vite dev server origin — used for CORS in development. Comma-separated
# for multiple allowed origins in production, e.g. your Vercel production
# domain plus its preview-deployment domain(s):
# FRONTEND_URL=https://adriva.vercel.app,https://adriva-git-main-you.vercel.app
FRONTEND_URL=http://localhost:5173

# The public base URL profile links/QR codes/vCards are built from, e.g.
# https://adriva.app in production. No trailing slash.
PUBLIC_BASE_URL=http://localhost:8000

# Where uploaded files are written, relative to the backend/ directory.
UPLOAD_DIR=uploads
